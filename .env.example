# ===== PostgreSQL =====
DB_USER=okf_user
DB_PASSWORD=okf_password
DB_NAME=okf_db
DATABASE_URL=postgres://okf_user:okf_password@postgres:5432/okf_db?sslmode=disable

# ===== RabbitMQ =====
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=jobs

# ===== MinIO =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# URL pública de MinIO (accesible desde el navegador) para URLs firmadas
BUCKET_ORIGINALS=originals
BUCKET_BUNDLES=bundles

# ===== API =====
PORT=8080
JWT_SECRET=change-me-in-production
LOG_LEVEL=info

# ===== Worker =====
WORK_DIR=/tmp/okf
PDF_CHUNK_PAGES=10
# ===== Puertos publicados en el host =====
# Cámbialos si alguno ya está ocupado por otro proyecto.
API_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
